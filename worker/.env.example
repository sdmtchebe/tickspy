# Copy to .env for `wrangler dev` only. NEVER commit .env.
#
# In production these are NOT read from this file. A deployed Worker gets them
# from Cloudflare, set once with:
#
#   npx wrangler secret put GEMINI_API_KEY
#
# Secrets set this way are encrypted at rest, are not visible in the dashboard
# after entry, never reach the browser, and are stripped from logs and from any
# error we return.

# Required. Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-lite-latest from wrangler.toml.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://sdmtchebe.github.io,*.netlify.app,http://localhost:3000

# Comments. In production this is a Worker secret:
#   npx wrangler secret put COMMENTS_ADMIN_TOKEN
# Any long random string works; it only gates /api/comments/admin and the
# moderation page. For local `wrangler dev`, a throwaway value is fine.
COMMENTS_ADMIN_TOKEN=

# Comments bot gate. Optional: set BOTH to require Cloudflare Turnstile on every
# post (and to render the widget). The site key is public and lives in
# wrangler.toml in production; the secret is a Worker secret. Leave both empty
# and the wall keeps working exactly as before.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
